[Unit]
Description=Periodic trigger for prompt-vault-cert-rotation.service

[Timer]
# Well inside the role's ttl (72h for agent certs, 720h for on-call by
# default - see CERT_ROTATION_MODE in ../bootstrap_openbao.sh) so a missed
# run or two is never a problem.
OnUnitActiveSec=__ROTATION_INTERVAL__
Persistent=true

[Install]
WantedBy=timers.target
