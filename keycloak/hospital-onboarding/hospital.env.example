# Copy to hospital-<slug>.env and fill in. Used by onboard-hospital.sh + sync.

# --- Keycloak admin (master) ---
KC_URL=http://127.0.0.1:8080
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=REPLACE_ME

# --- Hospital realm (identity) ---
HOSPITAL_SLUG=meridian
# Realm id: hospital-${HOSPITAL_SLUG}
HOSPITAL_DISPLAY_NAME=Meridian Hospital
LOGIN_LOGO_URL=https://cdn.example.com/hospitals/meridian-logo.png
LOGIN_THEME=xelerait

# --- Org DB (permissions + mirrored users) ---
# Used by sync-kc-personas-to-orgdb.sh — not required for KC-only onboard.
ORG_DB_HOST=127.0.0.1
ORG_DB_PORT=5432
ORG_DB_NAME=action_requests
ORG_DB_USER=app
ORG_DB_PASSWORD=REPLACE_ME
# Stable hospital id in org DB (UUID or slug your schema expects)
HOSPITAL_ID=meridian

# --- Clients (same ids every hospital; URIs differ) ---
RACC_CLIENT_ID=racc
RACC_ROOT_URL=https://racc.meridian.example
RACC_REDIRECT_URIS=https://racc.meridian.example/*
RACC_WEB_ORIGINS=https://racc.meridian.example

POD_CLIENT_ID=pod
POD_ENABLED=false
POD_ROOT_URL=https://pod.meridian.example
POD_REDIRECT_URIS=https://pod.meridian.example/*
POD_WEB_ORIGINS=https://pod.meridian.example
